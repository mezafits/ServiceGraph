 @using System.Collections.Generic

 @inject IJSRuntime JSRuntime
 @inject ISyncService syncService

<style>
    .metadata-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    }

    .metadata-card {
    margin-top: 10px;
    background: #f5f5f5;
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .metadata-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-weight: bold;
    }

    .metadata-tag {
    font-size: 1.1rem;
    }

    .metadata-type {
    background-color: #d0e7ff;
    color: #0078d4;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.8rem;
    }

    .metadata-content {
    font-size: 0.95rem;
    color: #333;
    }

    .metadata-link {
    color: #0066cc;
    text-decoration: none;
    word-break: break-all;
    }

    .metadata-code {
    background-color: #eaeaea;
    padding: 0.5rem;
    border-radius: 4px;
    font-family: Consolas, monospace;
    overflow-x: auto;
    }

    .tab-content {
        max-height: 70vh; /* Or any height you find appropriate */
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 1rem; /* Optional: space for scrollbar */
    }

    .notes-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .notes-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        justify-content: flex-start;
    }

    .font-scale-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .font-scale-slider {
        width: 100px;
    }

    .scaled-content {
        font-size: calc(1rem * var(--font-scale, 1));
    }

    .scaled-content * {
        font-size: inherit !important;
    }

    .scaled-content h1 {
        font-size: calc(1.5rem * var(--font-scale, 1)) !important;
    }

    .scaled-content h2 {
        font-size: calc(1.25rem * var(--font-scale, 1)) !important;
    }

    .scaled-content h3 {
        font-size: calc(1.1rem * var(--font-scale, 1)) !important;
    }

    .scaled-content pre, .scaled-content code {
        font-size: calc(0.9rem * var(--font-scale, 1)) !important;
    }

    .notes-textarea {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 1rem;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 14px;
        line-height: 1.5;
        resize: vertical;
        width: 100%;
        height: calc(70vh - 120px);
        box-sizing: border-box;
        outline: none;
    }

    .notes-textarea:focus {
        border-color: #0078d4;
        box-shadow: 0 0 0 2px rgba(0, 120, 212, 0.2);
    }

    .notes-preview {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 1rem;
        background-color: #fafafa;
        height: calc(70vh - 120px);
        line-height: 1.6;
        overflow-y: auto;
    }

    .notes-preview h1 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .notes-preview h2 {
        font-size: 1.25rem;
        margin-bottom: 0.75rem;
        margin-top: 1.5rem;
        color: #555;
    }

    .notes-preview h3 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        margin-top: 1rem;
        color: #666;
    }

    .notes-preview pre {
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 1rem;
        overflow-x: auto;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9rem;
    }

    .notes-preview code {
        background-color: #f5f5f5;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9rem;
    }

    .notes-preview pre code {
        background-color: transparent;
        padding: 0;
    }

    .notes-preview a {
        color: #0066cc;
        text-decoration: none;
    }

    .notes-preview a:hover {
        text-decoration: underline;
    }
</style>

<div class="metadata-container">
    <FluentTabs @bind-ActiveTabId="@activeTabId">
        <FluentTab Id="Notes" Label="Notes">
            <div class="tab-content">
                <div class="notes-section">
                    <div class="notes-controls">
                        <FluentButton Appearance="Appearance.Outline" Size="Size.Small" OnClick="ToggleNotesEditMode" Title="@(isNotesEditMode ? "Preview" : "Edit")" IconStart="@(isNotesEditMode ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Eye() : new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Edit())" Style="width: auto; min-width: 40px;" />
                        <div class="font-scale-control">
                            <FluentLabel Style="font-size: 0.9rem;">Scale:</FluentLabel>
                            <FluentSlider @bind-Value="fontScale" Min="0.5" Max="2.0" Step="0.1" class="font-scale-slider" />
                            <FluentLabel Style="font-size: 0.8rem; color: #666;">@(Math.Round(fontScale * 100))%</FluentLabel>
                        </div>
                    </div>
                    @if (isNotesEditMode)
                    {
                        <div class="notes-editor">
                            <textarea @bind="notesMarkdown" class="notes-textarea scaled-content" style="--font-scale: @fontScale;"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="notes-preview scaled-content" style="--font-scale: @fontScale;">
                            @((MarkupString)ConvertMarkdownToHtml(notesMarkdown))
                        </div>
                    }
                </div>
            </div>
        </FluentTab>
        <FluentTab Id="Properties" Label="Properties">
            <div class="tab-content">
                <MetaDataPropertiesComponent OnSelected=SelectMetadata metadata="@propertyMetadata" />
            </div>
        </FluentTab>
    </FluentTabs>
</div>




@code {


    private string BSOType = string.Empty;
    private List<Metadata> metadataItems;
    private List<Metadata> exampleItems;
    private BaseObject baseObject;
    private Metadata selectedMetadata = new Metadata();
    private List<Metadata> propertyMetadata = new List<Metadata>();
    private string notesMarkdown = string.Empty;
    private bool isNotesEditMode = false;
    private string activeTabId = "Notes";
    private double fontScale = 1.0;
    protected override Task OnInitializedAsync()
    {


        exampleItems = new List<Metadata>
            {
                new Metadata
                {
                    TagName = "Geneva Account",
                    TagType = "Property",
                    TagValue = "sample-account"
                }
            };
        propertyMetadata = exampleItems.Where(x => x.TagType == "Property").ToList();
        notesMarkdown = "# Notes\n\nAdd your notes here...";




        return base.OnInitializedAsync();
    }

    private void SelectMetadata(Metadata item)
    {
        selectedMetadata = item;
    }



    public async Task ViewServiceNode(ServiceNode node)
    {
        BSOType = "ServiceNode";
        await ViewMetaData(node);
    }
    public async Task ViewEdge(Edge edge)
    {
        BSOType = "Edge";
        await ViewMetaData(edge);
    }
    public async Task ViewProject(Project project)
    {
        BSOType = "Project";    
        await ViewMetaData(project);
    }

     
    private async Task ViewMetaData(BaseObject bso)
    {
        baseObject = bso;
        var items = bso.Metadata ?? new List<Metadata>();
        
        // Separate properties from other metadata
        propertyMetadata = items.Where(x => x.TagType == "Property").ToList();
        
        // Combine all non-property metadata into markdown
        var notesItems = items.Where(x => x.TagType != "Property").ToList();
        notesMarkdown = ConvertMetadataToMarkdown(notesItems);
        
        if (string.IsNullOrEmpty(notesMarkdown))
        {
            notesMarkdown = "# Notes\n\nAdd your notes here...";
        }
        
        StateHasChanged();
    }
    
    private string ConvertMetadataToMarkdown(List<Metadata> metadata)
    {
        if (!metadata.Any()) return string.Empty;
        
        var markdown = new System.Text.StringBuilder();
        
        foreach (var item in metadata)
        {
            switch (item.TagType?.ToLower())
            {
                case "link":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine($"[{item.TagName}]({item.TagValue})");
                    markdown.AppendLine();
                    break;
                case "text":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine();
                    break;
                case "code":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine("```");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine("```");
                    markdown.AppendLine();
                    break;
                default:
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine();
                    break;
            }
        }
        
        return markdown.ToString();
    }
    
    private string ConvertMarkdownToHtml(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        
        // Simple markdown to HTML conversion
        var html = markdown
            .Replace("\n", "<br/>")
            .Replace("# ", "<h1>").Replace("<br/><h1>", "</h1><h1>")
            .Replace("## ", "<h2>").Replace("<br/><h2>", "</h2><h2>")
            .Replace("### ", "<h3>").Replace("<br/><h3>", "</h3><h3>");
            
        // Handle code blocks
        html = System.Text.RegularExpressions.Regex.Replace(html, @"```(.*?)```", "<pre><code>$1</code></pre>", System.Text.RegularExpressions.RegexOptions.Singleline);
        
        // Handle links
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[([^\]]+)\]\(([^)]+)\)", "<a href=\"$2\" target=\"_blank\">$1</a>");
        
        return html;
    }
    
    private void ToggleNotesEditMode()
    {
        isNotesEditMode = !isNotesEditMode;
    }
    
    private void RefreshData()
    {
        if (baseObject != null)
        {
            propertyMetadata = baseObject.Metadata?.Where(x => x.TagType == "Property").ToList() ?? new List<Metadata>();
            StateHasChanged();
        }
    }
}