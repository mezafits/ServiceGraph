 @using System.Collections.Generic

 @inject IJSRuntime JSRuntime
 @inject ISyncService syncService

<style>
    .metadata-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        padding: var(--space-sm);
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-left: 1px solid var(--neon-blue-start);
        box-shadow: -5px 0 20px var(--neon-blue-glow);
        min-height: 100vh;
        position: relative;
        font-family: 'Inter', sans-serif;
    }

    .metadata-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 50% 20%, var(--neon-blue-glow) 0%, transparent 50%),
            radial-gradient(circle at 50% 80%, var(--neon-purple-glow) 0%, transparent 50%);
        opacity: 0.03;
        pointer-events: none;
    }

    .metadata-card {
        margin-top: var(--space-md);
        background: var(--glass-bg);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid var(--neon-blue-start);
        border-radius: var(--border-radius-lg);
        padding: var(--space-lg);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3), 0 0 15px var(--neon-blue-glow);
        position: relative;
        z-index: 2;
        transition: all var(--transition-normal);
    }

    .metadata-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--neon-blue-start), var(--neon-purple-start));
        border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
        box-shadow: 0 0 8px var(--neon-blue-glow);
    }

    .metadata-card:hover {
        border-color: var(--neon-blue-end);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.4), 0 0 20px var(--neon-blue-glow);
        transform: translateY(-2px);
    }

    .metadata-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-md);
        font-weight: 600;
        color: var(--text-primary);
    }

    .metadata-tag {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--neon-blue-end);
        text-shadow: 0 0 8px var(--neon-blue-glow);
        letter-spacing: -0.01em;
    }

    .metadata-type {
        background: linear-gradient(135deg, var(--neon-purple-start), var(--neon-blue-start));
        color: var(--text-primary);
        border-radius: var(--border-radius-sm);
        padding: 0.3rem 0.8rem;
        font-size: 0.8rem;
        font-weight: 500;
        box-shadow: 0 0 10px var(--neon-purple-glow);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metadata-content {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.7;
        font-weight: 400;
    }

    .metadata-link {
        color: var(--neon-blue-end);
        text-decoration: none;
        word-break: break-all;
        transition: all var(--transition-fast);
        position: relative;
    }

    .metadata-link:hover {
        color: var(--text-primary);
        text-shadow: 0 0 8px var(--neon-blue-glow);
        text-decoration: underline;
    }

    .dataviewer-header {
        background: var(--glass-bg);
        border-bottom: 1px solid var(--neon-blue-start);
        padding: var(--space-lg);
        margin: 0 0 var(--space-lg) 0;
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
    }

    .dataviewer-title {
        color: var(--neon-purple-end);
        font-size: 1.5rem;
        font-weight: 700;
        text-shadow: 0 0 12px var(--neon-purple-glow);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .empty-state {
        text-align: center;
        padding: var(--space-xxl);
        color: var(--text-tertiary);
        font-style: italic;
    }

    .property-grid {
        display: grid;
        gap: var(--space-sm);
    }

    .property-row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: var(--space-md);
        padding: var(--space-sm) 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .property-label {
        color: var(--neon-teal-end);
        font-weight: 600;
        font-size: 0.9rem;
        text-shadow: 0 0 5px var(--cyber-teal-glow);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .property-value {
        color: var(--text-primary);
        font-family: 'JetBrains Mono', 'Consolas', 'Monaco', monospace;
        font-size: 0.95rem;
        word-break: break-word;
        line-height: 1.5;
        background: rgba(0, 0, 0, 0.2);
        padding: 0.25rem 0.5rem;
        border-radius: var(--border-radius-sm);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .json-preview {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--neon-purple-start);
        border-radius: var(--border-radius-md);
        padding: var(--space-md);
        margin-top: var(--space-md);
        overflow-x: auto;
    }

    .json-preview code {
        color: var(--neon-green-end);
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.85rem;
        white-space: pre-wrap;
    }

    .metadata-code {
        background-color: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--neon-green-start);
        color: var(--neon-green-end);
        padding: var(--space-md);
        border-radius: var(--border-radius-md);
        font-family: 'Consolas', 'Monaco', monospace;
        overflow-x: auto;
        box-shadow: 0 0 10px var(--neon-green-glow);
    }

    .tab-content {
        max-height: 70vh;
        overflow-y: auto;
        overflow-x: hidden;
        padding: var(--space-lg);
        line-height: 1.6;
    }

    .tab-content h1, .tab-content h2, .tab-content h3 {
        color: var(--neon-blue-end);
        text-shadow: 0 0 8px var(--neon-blue-glow);
        margin-top: var(--space-xl);
        margin-bottom: var(--space-lg);
    }

    .tab-content p {
        color: var(--text-secondary);
        margin-bottom: var(--space-md);
        line-height: 1.7;
    }

    .tab-content ul, .tab-content ol {
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .tab-content li {
        margin-bottom: var(--space-xs);
    }

    .tab-content code {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--neon-green-start);
        color: var(--neon-green-end);
        padding: 0.2em 0.4em;
        border-radius: var(--border-radius-sm);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9em;
    }

    .tab-content pre {
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid var(--neon-green-start);
        border-radius: var(--border-radius-md);
        padding: var(--space-lg);
        overflow-x: auto;
        box-shadow: 0 0 15px var(--neon-green-glow);
        margin: var(--space-lg) 0;
    }

    .tab-content blockquote {
        background: rgba(139, 92, 246, 0.05);
        border-left: 4px solid var(--neon-purple-start);
        padding: var(--space-lg);
        margin: var(--space-lg) 0;
        border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0;
        box-shadow: -4px 0 10px var(--neon-purple-glow);
        font-style: italic;
    }

    .notes-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .notes-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        justify-content: flex-start;
    }

    .font-scale-control {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        color: var(--text-secondary);
    }

    .font-scale-control input[type="range"] {
        background: var(--glass-bg);
        border-radius: var(--border-radius-sm);
        height: 6px;
        outline: none;
        appearance: none;
    }

    .font-scale-control input[type="range"]::-webkit-slider-thumb {
        appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--neon-blue-start);
        box-shadow: 0 0 8px var(--neon-blue-glow);
        cursor: pointer;
    }

    .font-scale-control input[type="range"]::-moz-range-thumb {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--neon-blue-start);
        box-shadow: 0 0 8px var(--neon-blue-glow);
        cursor: pointer;
        border: none;
    }

    .notes-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        background: var(--glass-bg);
        border-radius: var(--border-radius-md);
        padding: var(--space-sm);
        border: 1px solid rgba(255, 255, 255, 0.1);
        height: calc(100vh - 100px);
    }

    .notes-controls {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        justify-content: flex-start;
        padding: var(--space-xs) 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
    }

    .edit-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .font-scale-slider {
        width: 100px;
    }

    .scaled-content {
        font-size: calc(1rem * var(--font-scale, 1));
    }

    .scaled-content * {
        font-size: inherit !important;
    }

    .scaled-content h1 {
        font-size: calc(1.5rem * var(--font-scale, 1)) !important;
    }

    .scaled-content h2 {
        font-size: calc(1.25rem * var(--font-scale, 1)) !important;
    }

    .scaled-content h3 {
        font-size: calc(1.1rem * var(--font-scale, 1)) !important;
    }

    .scaled-content pre, .scaled-content code {
        font-size: calc(0.9rem * var(--font-scale, 1)) !important;
    }

    .notes-textarea {
        background: var(--glass-bg);
        border: 1px solid var(--neon-blue-start);
        border-radius: var(--border-radius-md);
        color: var(--text-primary);
        padding: var(--space-sm);
        font-family: 'JetBrains Mono', 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 14px;
        line-height: 1.6;
        resize: none;
        width: 100%;
        flex: 1;
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        transition: all var(--transition-normal);
    }

    .notes-textarea:focus {
        outline: none;
        border-color: var(--neon-blue-end);
        box-shadow: 0 0 15px var(--neon-blue-glow);
        background: rgba(255, 255, 255, 0.08);
    }

    .notes-textarea::placeholder {
        color: var(--text-tertiary);
    }

    .notes-textarea {
        box-sizing: border-box;
        outline: none;
    }

    .notes-textarea:focus {
        border-color: #0078d4;
        box-shadow: 0 0 0 2px rgba(0, 120, 212, 0.2);
    }

    .notes-preview {
        border: 1px solid var(--neon-blue-start);
        border-radius: var(--border-radius-md);
        padding: var(--space-sm);
        background: #f8f8f2;
        flex: 1;
        line-height: 1.6;
        overflow-y: auto;
        color: #2d3748;
    }

    .notes-preview h1 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a202c;
    }

    .notes-preview h2 {
        font-size: 1.25rem;
        margin-bottom: 0.75rem;
        margin-top: 1.5rem;
        color: #2d3748;
    }

    .notes-preview h3 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        margin-top: 1rem;
        color: #4a5568;
    }

    .notes-preview pre {
        background-color: #f1f1f1;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        padding: 1rem;
        overflow-x: auto;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9rem;
        color: #374151;
    }

    .notes-preview code {
        background-color: #f1f1f1;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9rem;
        color: #374151;
    }

    .notes-preview pre code {
        background-color: transparent;
        padding: 0;
    }

    .notes-preview a {
        color: #3182ce;
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .notes-preview a:hover {
        color: #2c5aa0;
        text-decoration: underline;
    }

    .notes-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        padding: 2rem;
        color: #6b7280;
    }

    .notes-empty-icon {
        font-size: 4rem;
        color: #d1d5db;
        margin-bottom: 1rem;
    }

    .notes-empty-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .notes-empty-subtitle {
        font-size: 1rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
    }

    .notes-empty-features {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .notes-empty-feature {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #9ca3af;
        font-size: 0.9rem;
    }

    .notes-empty-feature-icon {
        color: #3182ce;
        font-weight: bold;
    }
</style>

<div class="metadata-container">
    <div class="notes-section">
        <div class="notes-controls">
            <FluentButton Appearance="Appearance.Outline" Size="Size.Small" OnClick="ToggleNotesEditMode" Title="@(isNotesEditMode ? "Preview" : "Edit")" IconStart="@(isNotesEditMode ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Eye() : new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Edit())" Style="width: auto; min-width: 40px;" />
            <div class="font-scale-control">
                <FluentLabel Style="font-size: 0.9rem;">Scale:</FluentLabel>
                <FluentSlider @bind-Value="fontScale" Min="0.5" Max="2.0" Step="0.1" class="font-scale-slider" />
                <FluentLabel Style="font-size: 0.8rem; color: #666;">@(Math.Round(fontScale * 100))%</FluentLabel>
            </div>
        </div>
        @if (isNotesEditMode)
        {
            <textarea @bind="notesMarkdown" class="notes-textarea scaled-content" style="--font-scale: @fontScale;"></textarea>
        }
        else
        {
            <div class="notes-preview scaled-content" style="--font-scale: @fontScale;">
                @((MarkupString)ConvertMarkdownToHtml(notesMarkdown))
            </div>
        }
    </div>
    
    @* Commented out Properties tab
    <FluentTabs @bind-ActiveTabId="@activeTabId">
        <FluentTab Id="Properties" Label="Properties">
            <div class="tab-content">
                <MetaDataPropertiesComponent OnSelected=SelectMetadata metadata="@propertyMetadata" />
            </div>
        </FluentTab>
    </FluentTabs>
    *@
</div>




@code {


    private string BSOType = string.Empty;
    private List<Metadata> metadataItems;
    private List<Metadata> exampleItems;
    private BaseObject baseObject;
    private Metadata selectedMetadata = new Metadata();
    private List<Metadata> propertyMetadata = new List<Metadata>();
    private string notesMarkdown = string.Empty;
    private bool isNotesEditMode = false;
    private string activeTabId = "Notes";
    private double fontScale = 1.0;
    protected override Task OnInitializedAsync()
    {


        exampleItems = new List<Metadata>
            {
                new Metadata
                {
                    TagName = "Geneva Account",
                    TagType = "Property",
                    TagValue = "sample-account"
                }
            };
        propertyMetadata = exampleItems.Where(x => x.TagType == "Property").ToList();
        notesMarkdown = "# Notes\n\nAdd your notes here...";




        return base.OnInitializedAsync();
    }

    private void SelectMetadata(Metadata item)
    {
        selectedMetadata = item;
    }



    public async Task ViewServiceNode(ServiceNode node)
    {
        BSOType = "ServiceNode";
        await ViewMetaData(node);
    }
    public async Task ViewEdge(Edge edge)
    {
        BSOType = "Edge";
        await ViewMetaData(edge);
    }
    public async Task ViewProject(Project project)
    {
        BSOType = "Project";    
        await ViewMetaData(project);
    }

     
    private async Task ViewMetaData(BaseObject bso)
    {
        baseObject = bso;
        var items = bso.Metadata ?? new List<Metadata>();
        
        // Separate properties from other metadata
        propertyMetadata = items.Where(x => x.TagType == "Property").ToList();
        
        // Combine all non-property metadata into markdown
        var notesItems = items.Where(x => x.TagType != "Property").ToList();
        notesMarkdown = ConvertMetadataToMarkdown(notesItems);
        
        if (string.IsNullOrEmpty(notesMarkdown))
        {
            notesMarkdown = "# Notes\n\nAdd your notes here...";
        }
        
        StateHasChanged();
    }
    
    private string ConvertMetadataToMarkdown(List<Metadata> metadata)
    {
        if (!metadata.Any()) return string.Empty;
        
        var markdown = new System.Text.StringBuilder();
        
        foreach (var item in metadata)
        {
            switch (item.TagType?.ToLower())
            {
                case "link":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine($"[{item.TagName}]({item.TagValue})");
                    markdown.AppendLine();
                    break;
                case "text":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine();
                    break;
                case "code":
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine("```");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine("```");
                    markdown.AppendLine();
                    break;
                default:
                    markdown.AppendLine($"## {item.TagName}");
                    markdown.AppendLine(item.TagValue);
                    markdown.AppendLine();
                    break;
            }
        }
        
        return markdown.ToString();
    }
    
    private string ConvertMarkdownToHtml(string markdown)
    {
        if (string.IsNullOrEmpty(markdown) || markdown.Trim() == "# Notes\n\nAdd your notes here...")
        {
            return @"<div class=""notes-empty-state"">
                        <div class=""notes-empty-icon"">📝</div>
                        <div class=""notes-empty-title"">Start Taking Notes</div>
                        <div class=""notes-empty-subtitle"">Click Edit to begin documenting your thoughts</div>
                        <ul class=""notes-empty-features"">
                            <li class=""notes-empty-feature"">
                                <span class=""notes-empty-feature-icon"">✓</span>
                                Markdown support for rich formatting
                            </li>
                            <li class=""notes-empty-feature"">
                                <span class=""notes-empty-feature-icon"">✓</span>
                                Live preview with font scaling
                            </li>
                            <li class=""notes-empty-feature"">
                                <span class=""notes-empty-feature-icon"">✓</span>
                                Code blocks and links supported
                            </li>
                        </ul>
                    </div>";
        }
        
        // Simple markdown to HTML conversion
        var html = markdown
            .Replace("\n", "<br/>")
            .Replace("# ", "<h1>").Replace("<br/><h1>", "</h1><h1>")
            .Replace("## ", "<h2>").Replace("<br/><h2>", "</h2><h2>")
            .Replace("### ", "<h3>").Replace("<br/><h3>", "</h3><h3>");
            
        // Handle code blocks
        html = System.Text.RegularExpressions.Regex.Replace(html, @"```(.*?)```", "<pre><code>$1</code></pre>", System.Text.RegularExpressions.RegexOptions.Singleline);
        
        // Handle links
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[([^\]]+)\]\(([^)]+)\)", "<a href=\"$2\" target=\"_blank\">$1</a>");
        
        return html;
    }
    
    private void ToggleNotesEditMode()
    {
        isNotesEditMode = !isNotesEditMode;
    }
    
    private void RefreshData()
    {
        if (baseObject != null)
        {
            propertyMetadata = baseObject.Metadata?.Where(x => x.TagType == "Property").ToList() ?? new List<Metadata>();
            StateHasChanged();
        }
    }
}